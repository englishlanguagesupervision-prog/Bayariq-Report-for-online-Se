rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function profile() { return get(/databases/$(database)/documents/profiles/$(request.auth.uid)); }
  function role() { return signedIn() && exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) ? profile().data.role : "none"; }
  function manager() { return role() == "admin"; }
  function sectionAllowed(section) { return manager() || role() == section; }
  match /profiles/{uid} {
   allow read: if signedIn() && (request.auth.uid == uid || manager());
   allow write: if false; // Provision in Firebase Console or trusted Admin SDK only
  }
  match /reports/{reportId} {
   allow read: if role() in ["admin","primary","intermediate","secondary","special"];
   allow create,update,delete: if manager();
   match /cells/{cellId} {
    allow read: if role() in ["admin","primary","intermediate","secondary","special"];
    allow create,update: if sectionAllowed(request.resource.data.section)
      && request.resource.data.keys().hasOnly(["section","html","updatedAt","updatedBy"])
      && request.resource.data.section in ["admin","primary","intermediate","secondary","special"]
      && request.resource.data.html is string
      && request.resource.data.html.size() <= 20000
      && request.resource.data.updatedBy == request.auth.uid
      && request.resource.data.updatedAt == request.time
      && (resource == null || resource.data.section == request.resource.data.section)
      && get(/databases/$(database)/documents/reports/$(reportId)).data.locked != true;
    allow delete: if manager();
   }
  }
 }
}